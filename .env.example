# ============================================================================
# Draymond Orchestrator — Environment Variables
# Autonomous Business System Control Plane
# ============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Local Database (SQLite) ─────────────────────────────────────────────────
# Draymond stores all state in a single SQLite file — no servers, no accounts,
# runs 24/7 inside the app process. The file is created automatically on first
# boot at ./data/draymond.db.
DRAYMOND_DB_PATH=./data/draymond.db

# Local admin account. On a fresh database the admin is bootstrapped from these
# vars on first login. If DRAYMOND_ADMIN_PASSWORD is unset, a random password is
# generated and printed to the server console (see scripts/create-admin.mjs to
# set a known password instead).
DRAYMOND_ADMIN_EMAIL=admin@localhost
DRAYMOND_ADMIN_PASSWORD=change-me

# ─── Legacy Supabase (one-time migration only) ────────────────────────────────
# Only needed to dump existing data into the local DB:
#   node scripts/import-from-supabase.mjs dump
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Paid releases (local file serving) ───────────────────────────────────────
# Directory holding the release binaries served by /api/downloads/*.
DRAYMOND_RELEASES_DIR=./data/paid-releases

# ─── Deep-scoring agents (Roster Benchmark) ───────────────────────────────────
# Used by the `benchmark_roster` job to score each pictured agent's repo with
# RepoRank + Grader (+ optional Vibe-Reality). Point these at your running
# servers and create the API keys there. When unset, the scorers fail soft and
# the benchmark records "no deep scores".
REPORANK_URL=http://localhost:3200
REPORANK_API_KEY=your-reporank-api-key
GRADER_URL=http://localhost:3201
GRADER_API_KEY=your-grader-api-key
VIBE_REALITY_URL=http://localhost:3202
VIBE_REALITY_ID_TOKEN=

# ─── LLM Providers ──────────────────────────────────────────────────────────
# OpenAI — used by Vercel AI SDK for swarm task decomposition
OPENAI_API_KEY=your-openai-api-key

# Anthropic — used for Claude API calls (agent invocations, etc.)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Qwen (primary LLM — Uplift Guide AI + news analysis)
QWEN_API_KEY=your-qwen-api-key

# ─── News APIs ────────────────────────────────────────────────────────────────
NEWSAPI_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-api-key
WORLDNEWS_API_KEY=your-worldnews-api-key

# ─── CRON / Admin ─────────────────────────────────────────────────────────────
# Protects /api/cron, /api/seed, /api/monitors/check, /api/notifications/test
# Use a long random string. Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret

# ─── Delegation / Fleet Budget ────────────────────────────────────────────────
# Fleet-wide daily token cap. The delegation plan (src/lib/draymond/delegation.ts)
# splits this across day phases (morning 30% / midday 20% / evening 15% / night 35%)
# and gives each agent/handler a per-run + per-day token budget. workflow-budget
# enforces the shared cap at the LLM-call layer. Default 5_000_000.
# DRAYMOND_FLEET_DAILY_BUDGET=5000000

# ─── SSRF / Local Agent Access ────────────────────────────────────────────────
# In production, the invoker blocks localhost/private IPs to prevent SSRF.
# In development (NODE_ENV!=production), localhost is allowed automatically.
# Set this to "1" to explicitly allow local agents in any environment:
# ALLOW_LOCAL_AGENTS=1

# ─── Email Notifications (Gmail + Nodemailer) ────────────────────────────────
# Gmail address to send notifications FROM
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Factor Authentication enabled on the Google account
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email address to receive alert notifications (defaults to GMAIL_USER)
DRAYMOND_ALERT_EMAIL=your-alert-recipient@gmail.com

# ─── ntfy Push Approvals (human-in-the-loop relay) ───────────────────────────
# When a confidence-gated action is queued for review, Draymond publishes an
# ntfy notification with Approve/Reject HTTP action buttons. Open-Chat
# subscribes to the topic and renders the buttons, which POST back here.
#
# Public ntfy server (free) — or self-host at https://docs.ntfy.sh/install/
NTFY_URL=https://ntfy.sh

# Any string topic — ideally unique to your deployment to avoid collisions.
NTFY_TOPIC=draymond-approvals

# Publicly reachable base URL of THIS app. Used to build the review callback
# URL embedded in the ntfy notification. Use a tunnel (e.g. Cloudflare) in
# development if the phone is not on your LAN.
DRAYMOND_PUBLIC_URL=https://your-draymond-instance.com

# ─── Agent URLs ──────────────────────────────────────────────────────────────
# Each agent gets a unique port to avoid conflicts.
# Draymond itself runs on :3444. The canonical allocation lives in
# src/lib/draymond/ports.ts — keep these two in sync.
#
# PORT MAP (canonical):
#   3444  — Draymond Orchestrator (this app)
#   3001  — Bet Buddy (Express.js, companion to Sports Steve)
#   3010  — OmniResearch Pro (Express.js backend)
#   3020  — Overlay Chain / ChainFlow (Next.js supply chain)
#   3100  — Hemp-OS (scientific research OS)
#   3110  — HempForge (moved off 3000)
#   3200  — RepoRank (repo scoring + progress)      ← was 3001
#   3201  — Grader (data-backed grade)              ← was 3000
#   3202  — Vibe-Reality (deep scorer)
#   3300  — Claw-Protect (security scanner)         ← was 3333
#   3301  — dep-scan (dependency CVE scanner)
#   3302  — nuclei (external vuln scanner)
#   3333  — Ghostfolio (portfolio tracker)
#   3410  — Recursive IP (moved off 8000)
#   3500  — Big Homie (LLM agent backend / quality gate)
#   3600  — VibeServe (MCP tool router)            ← was 8000
#   3700  — AgentBrowser (browser automation)       ← was 3000
#   4000  — Mutly (IDE daemon + semantic search)
#   4100  — LiteLLM gateway                         ← was 4000
#   8000  — Uplift Agent (batch_server.py, Hermes fork)
#   8010  — Sports Steve (FastAPI sports betting)
#   8020  — Indy Music Platform / NC Studio (FastAPI)
#   8030  — Social Media Dashboard AI API (FastAPI)
#   8040  — TradingAgents HTTP wrapper (future — currently python_module)
#   8050  — Sub Team HTTP wrapper (future — currently subprocess)
#   8777  — BookBridge
#   9744  — MegaCode JetBrains bridge (HTTP)

# Uplift Agent (Hermes fork — primary worker, batch_server.py)
UPLIFT_BASE_URL=http://localhost:8000

# Sports Steve (FastAPI — daily bet assessment + resolution)
SPORTS_STEVE_URL=http://localhost:8010

# Bet Buddy (Express.js — odds calc, Kelly criterion, bankroll)
BET_BUDDY_URL=http://localhost:3001

# Social Media Dashboard AI API (FastAPI — text/image/video/podcast/voice)
SOCIAL_MEDIA_URL=http://localhost:8030

# OmniResearch Pro (Express.js — Ollama proxy, web search, Slack/Notion)
OMNI_RESEARCH_URL=http://localhost:3010

# Indy Music Platform / NC Studio (FastAPI — artist sites, social, distribution)
INDY_MUSIC_URL=http://localhost:8020

# MegaCode / OverCoat (TypeScript — JetBrains HTTP bridge)
MEGACODE_URL=http://localhost:9744

# Overlay Chain / ChainFlow (Next.js — supply chain intelligence)
OVERLAY_CHAIN_URL=http://localhost:3020

# TradingAgents (Python library — no HTTP server, invoked via python_module)
# Only needed if you deploy an HTTP wrapper:
# TRADING_AGENTS_URL=http://localhost:8040
TRADING_AGENTS_DIR=/path/to/agents/TradingAgents-main

# Sub Team (Python library — no HTTP server, invoked via subprocess)
# Only needed if you deploy an HTTP wrapper:
# SUB_TEAM_URL=http://localhost:8050
SUB_TEAM_DIR=/path/to/agents/Sub-Team-main

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for auth redirect URLs. In production set to your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3444
NEXT_PUBLIC_APP_URL=http://localhost:3444

# ─── Python Runtimes ─────────────────────────────────────────────────────────
# Path to Python executables for subprocess/module invocations.
# On Windows, "python" is usually correct. On macOS/Linux, use "python3".
CCE_PYTHON=python
TRADING_AGENTS_PYTHON=python
SUB_TEAM_PYTHON=python

# ─── Paths ────────────────────────────────────────────────────────────────────
# Root directory for Claude Code Extension agent
CCE_ROOT=/path/to/cce

# File-based registry directory (defaults to .draymond/ in project root)
DRAYMOND_REGISTRY_DIR=.draymond

# Audit log file path (flat-file append log for admin audit trail)
AUDIT_LOG_PATH=.draymond/audit.log

# ── DeepSeek Router LLM ──────────────────────────────────────────────────────
# Primary LLM for Draymond's Intelligent Task Router (intent classification).
DEEPSEEK_API_KEY=your-deepseek-api-key

# ── AetherDesk Call Center Integration ───────────────────────────────────────
# Native AetherDesk FastAPI (no Docker) — see Aetherdesk-Call-Center/Makefile.
# Run: make setup && make dev  (uvicorn on 127.0.0.1:8000, SQLite)
AETHERDESK_BASE_URL=http://127.0.0.1:8000/api/v1
# Mirror INTERNAL_API_KEY from Aetherdesk-Call-Center/.env (generated by make setup)
AETHERDESK_API_KEY=your-aetherdesk-internal-api-key

# ── Stripe billing (Treasurer — the settled-cash pulse) ─────────────────────
# The Treasurer cron (`treasury_pulse`, daily 8am) pulls settled charges and
# updates revenue-to-date. Set STRIPE_SECRET_KEY to start counting real money;
# without it the pulse reports "not configured" and revenue stays $0 (never
# estimated). STRIPE_WEBHOOK_SECRET powers the real-time webhook at
# /api/business/stripe-webhook (set it in the Stripe dashboard to point here).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Lookback window for the daily pulse (days). Default 30.
# TREASURY_LOOKBACK_DAYS=30

# ── Sale alerts (Draymond pings you when money lands) ───────────────────────
# Every newly-settled Stripe charge fires a real-time alert: an ntfy push to
# NTFY_TOPIC_RESULTS (Open-Chat subscribes) plus a sales email to
# DRAYMOND_ALERT_EMAIL / GMAIL_USER. Wired into both the Stripe webhook
# (instant) and the daily `treasury_pulse` catch-up. Each charge alerts once
# (deduped in .draymond/treasury.json). No extra env needed — reuse NTFY_URL,
# NTFY_TOPIC_RESULTS, DRAYMOND_ALERT_EMAIL / GMAIL_USER.

# ── ntfy Result Notifications ────────────────────────────────────────────────
# Separate topic from NTFY_TOPIC so approval messages stay clean.
# Open-Chat subscribes to this topic (plus draymond-approvals) via an ntfy bot.
# Sale alerts publish here with tags ["moneybag","tada","sale"] so Open-Chat
# auto-speaks them when the bot has voice calling enabled.
NTFY_TOPIC_RESULTS=draymond-results

# ── Open-Chat webhook (workplace communicator) ───────────────────────────────
# Optional. When set, recaps and sale alerts are ALSO pushed straight into an
# Open-Chat conversation via its incoming webhook, in addition to ntfy + email.
# OPENCHAT_WEBHOOK=https://openchat.example.com/api/incoming

# OpenCode Zen free / Go tiers (used by the LLM provider chain in llm.ts)
OPENCODE_API_KEY=your-opencode-api-key

# Google Gemini (Generative Language API) - fallback provider in the chain
GEMINI_API_KEY=your-gemini-api-key

# CORS - comma-separated origins allowed to call /api/* from the browser.
# When unset, cross-origin browser requests are denied (server-side clients unaffected).
CORS_ORIGIN=https://your-frontend-origin.com

# LiteLLM gateway — when LITELLM_API_KEY is set, Draymond's LLM router tries the
# gateway first (http://localhost:4100/v1/chat/completions), then falls through
# to direct providers. Run: litellm --config config.yaml --port 4100
LITELLM_API_KEY=your-litellm-master-key
LITELLM_URL=http://localhost:4100

# ─── Free data APIs (free tiers) ─────────────────────────────────────────────
# No-key sources are wired and live: CoinGecko, MusicBrainz, OpenAlex, PubMed, OpenFDA.
# Key-gated sources (set to activate):
FINNHUB_API_KEY=your-finnhub-key
FRED_API_KEY=your-fred-key
VIRUSTOTAL_API_KEY=your-virustotal-key
THESPORTSDB_API_KEY=your-thesportsdb-key
USDA_API_KEY=your-usda-key
CASELAW_TOKEN=your-caselaw-token

# ─── Voice (clone + open-source) ─────────────────────────────────────────────
# Piper voices (open-source) — directory containing *.onnx + *.onnx.json models.
PIPER_MODELS_DIR=/path/to/piper-models
# Voice-clone sample (XTTS) — a short WAV of your voice for the user-clone.
VOICE_SAMPLE_WAV=/path/to/sample.wav

# ─── Book Library (BookBridge) ───────────────────────────────────────────────
# BookBridge REST endpoint (agents/BookBridge--main). Set DRAYMOND_BOOK_GROUNDING
# to "true" to have the chain-builder inject relevant book passages into task
# prompts so agents reason from the library instead of memorized guesswork.
BOOKBRIDGE_URL=http://127.0.0.1:8777
DRAYMOND_BOOK_GROUNDING=true

# ─── AgentBrowser (browser skills / file fetch / web search) ─────────────────
# AgentBrowser runs its own server (canonical :3700 — was :3000, which is taken
# by Overlay Justice / HempForge). It guards its browser API with an API key —
# set the matching value from AgentBrowser's .env (AGENT_API_KEY).
AGENTBROWSER_URL=http://localhost:3700
AGENTBROWSER_API_KEY=your-agentbrowser-api-key

# ─── Internal tool stack (see src/lib/draymond/ports.ts) ─────────────────────
# opencode — headless codegen engine (deepseek-v4-flash 0731 on the Go account).
# Runs `opencode serve --port 4096`. Keep OPENCODE_MODEL on the funded account.
OPENCODE_SERVE_PORT=4096
OPENCODE_MODEL=opencode/deepseek-v4-flash
# Mutly — IDE daemon / semantic search / sandboxed tests / RepoRank proxy.
MUTLY_URL=http://localhost:4000
# Codegang — local deep-analysis + agent pipeline (canonical :3204). The review
# gate uses its content-based /api/analyze-comprehensive as the local scorer.
# CODEGANG_API_KEY must equal the SECRET_KEY set in agents/Codegang/.env.local.
CODEGANG_URL=http://localhost:3204
CODEGANG_API_KEY=your-codegang-secret-key
# VibeServe — FastMCP tool router (optional HTTP bridge).
VIBESERVE_URL=http://localhost:3600
# Claw-Protect — secrets / prompt-injection scanner.
CLAW_PROTECT_URL=http://localhost:3300
# CAI (Cybersecurity AI) — offensive/defensive AI security agents (v1.1.5).
# Runs under WSL (Unix-only REPL). Install: bash agents/CAI-main/setup-wsl.sh
CAI_URL=http://localhost:3303
CAI_MODEL=alias1
CAI_AGENT_TYPE=one_tool_agent
CAI_GUARDRAILS=true
CAI_TRACING=false
CAI_DISABLE_USAGE_TRACKING=true
ALIAS_API_KEY=your-alias-key-for-cai
# Big Homie — LLM agent backend / quality gate.
BIG_HOMIE_URL=http://localhost:3500
# Graphify — codebase knowledge graph (MCP stdio, port 3203). Index with
# scripts/graphify-index.ps1, serve with start-tools.ps1.
GRAPHIFY_URL=http://localhost:3203
GRAPHIFY_API_KEY=your-graphify-api-key
# Deterministic brain — metacognitive observer (FastAPI, port 3210). When set,
# the chat reports "what the brain found" and can trigger sweeps.
BRAIN_URL=http://localhost:3210

# ─── Kaggle data provider ─────────────────────────────────────────────────────
# New-style Kaggle access token (KGAT_…) from https://www.kaggle.com/settings/api.
# Draymond's data-apis.ts reads KAGGLE_API_TOKEN (or KAGGLE_USERNAME + KAGGLE_KEY)
# for /api/ops/kaggle and the research chain. The deterministic brain reads the
# same creds from agents/deterministic-brain/.kaggle/kaggle.json.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# ─── Free-API key registry (see Draymond/FREE-APIS.md + src/lib/draymond/api-keys.ts) ──
# Draymond audits these and reports configured/missing via /api/ops/api-keys.
# Add keys here as you acquire them; the fleet picks them up automatically.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
USDA_API_KEY=
CASELAW_TOKEN=
COURTLISTENER_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
CALCOM_API_KEY=
HUNTER_API_KEY=
ABSTRACT_EMAIL_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=
THESPORTSDB_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_API_KEY=
SERPAPI_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=

# ─── Error reporting (Sentry — self-hostable OSS) ─────────────────────────────
# Optional. When SENTRY_DSN is set, unhandled rejections / uncaught exceptions
# and scheduler/invoker failures are captured with context (aggregation, dedup,
# alerting). Unset = strict no-op. Self-host: docs.sentry.io or GlitchTip.
# Source-map upload during build additionally needs SENTRY_ORG + SENTRY_PROJECT
# + SENTRY_AUTH_TOKEN (only used when SENTRY_DSN is set).
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional: sample rate for performance traces (0.0–1.0, default 0.05).
# SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── Crash guard (autonomous 24/7) ───────────────────────────────────────────
# The process-wide crash guard reports unhandled rejections / uncaught
# exceptions to the audit trail + ntfy + Sentry. In production, an uncaught
# exception exits after reporting so PM2 restarts cleanly. Set to 0 to keep
# the process alive instead (riskier — state may be inconsistent).
# DRAYMOND_CRASH_EXIT=1
# PM2 memory-cap restart (see ecosystem.config.js).
# DRAYMOND_MAX_MEMORY_RESTART=1G

# ─── Learning → repair feedback (failure-loop guard) ─────────────────────────
# A repair signal is never blindly re-applied. After N applied repairs inside
# the cooldown window, further attempts escalate (loop-stop) instead of hammering
# the same repair; detectRepairLoops reports loops over the longer window so the
# repair team + on-call are notified. Register proven repairs without a code
# change by setting DRAYMOND_REPAIR_MAP to JSON:
#   {"qa:fail":{"name":"reindex","service":"agent-browser","command":["npx","tsx","scripts/x.ts"],"safe":true}}
DRAYMOND_REPAIR_COOLDOWN_MS=1800000
DRAYMOND_REPAIR_MAX_IN_COOLDOWN=3
DRAYMOND_REPAIR_LOOP_WINDOW_MS=604800000
DRAYMOND_REPAIR_LOOP_THRESHOLD=3
# DRAYMOND_REPAIR_MAP=

# ─── Metrics (Prometheus scrape — OSS failure-loop detection) ───────────────
# GET /api/ops/metrics returns Prometheus text. Auth: Bearer METRICS_TOKEN,
# falling back to CRON_SECRET. Prometheus + Alertmanager can then alert on
# job fail_rate / consecutive errors / monitors down.
METRICS_TOKEN=

# ─── LLM Observability (Langfuse) ────────────────────────────────────────────
# Optional. When set, every chat turn + router decision is ingested as a
# Langfuse trace via the public HTTP API (no SDK). Leave unset to disable.
# Self-host: docker run -d -p 3000:3000 langfuse/langfuse
LANGFUSE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# ─── Music Rights (ASCAP / HFA / MLC) ───────────────────────────────────────
# Directory holding AgentBrowser's mini-services/music-rights scripts.
# Credentials are passed per-request to /api/music/register, never stored.
MUSIC_RIGHTS_DIR=/path/to/agents/AgentBrowser-main/mini-services/music-rights

# ─── Deep Scorers (RepoRank / Grader / Vibe-Reality) ────────────────────────
# Scored by the Thursday benchmark deep-score pass and surfaced on the agent
# roster + upgrade queue. Absent URLs soft-fail (the benchmark loop keeps
# running with the scorers that are reachable).
#
# RepoRank API: the scan endpoint is async (Bull + Gemini). Submit a scan, then
# poll GET /api/v1/scans/:id until status = complete. Auth is a `gr_` API key
# created in RepoRank's org settings (Authorization: Bearer gr_...).
REPORANK_URL=http://localhost:3200
REPORANK_API_KEY=
REPORANK_POLL_INTERVAL_MS=3000
REPORANK_POLL_TIMEOUT_MS=120000

# Grader API: POST /api/grade is synchronous; auth is a `gr_` API key. The
# response is the full HealthReport (overallScore / gradeCategory). CSRF is
# skipped for Bearer clients.
GRADER_URL=http://localhost:3201
GRADER_API_KEY=
GRADER_TIMEOUT_MS=90000

# Vibe-Reality API: POST /api/analyze requires a Firebase ID token and returns
# a jobId; poll GET /api/jobs/:jobId until status = complete.
VIBE_REALITY_URL=
VIBE_REALITY_ID_TOKEN=
VIBE_POLL_INTERVAL_MS=3000
VIBE_POLL_TIMEOUT_MS=90000



# -- Math X (embedded) ---------------------------------------------------------
# Master switch for the /math lab + math API routes. When off, Draymond's
# hand-rolled scoring paths remain active.
MATHX_MODE=on

# Optional local models (Ollama). When set, math routes can fall back to these
# for cost-free local reasoning instead of cloud providers.
OLLAMA_BASE_URL=
OLLAMA_MODEL=deepseek-r1:8b
QWEN_BASE_URL=
QWEN_MODEL=qwen2.5-math:7b

# Enable the 15-domain expert prompts (Domain Expert mode).
MATHX_DOMAIN_PROMPTS=1

# ─── Agent IDE (coding team) ─────────────────────────────────────────────────
# The /ide surface lets you chat with a coding/repair team, watch them work
# live (SSE), and interject (pause / redirect / approve / message).
# Decision escalation ladder TTLs (ms): inline chat → Open Chat → email, then
# the Monte Carlo engine auto-decides.
# IDE_DECISION_CHAT_TTL_MS=120000
# IDE_DECISION_PUSH_TTL_MS=180000
# IDE_DECISION_EMAIL_TTL_MS=180000
# Review gate: a session can only claim "done" when a scorer clears this score.
# IDE_REVIEW_THRESHOLD=60
# Max IDE steps executed in parallel (independent steps with no dependencies).
# IDE_MAX_CONCURRENT=3

# ---- Hermes api_server (mission brain) ---------------------------------------
# The real NousResearch Hermes agent runs its OpenAI-compatible SSE adapter
# on this host:port. Open-Chat's HermesClient targets it as the fleet brain.
# API_SERVER_KEY is a long random secret shared with HermesClient only on
# the server side (never bundled into the phone APK).
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=replace-with-openssl-rand-hex-32

# ---- Hermes proxy relocation -------------------------------------------------
# The chat backend (Hermes api_server) owns 8642; the Node hermes-proxy keeps
# only media + AetherDesk voice proxy here. Voice util botHost must match.
HERMES_PROXY_PORT=8648
