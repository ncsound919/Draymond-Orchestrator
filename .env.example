# The Uplift Lab — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Qwen (primary LLM — Uplift Guide AI + news analysis) ────────────────────
# Get this from your Qwen API provider
QWEN_API_KEY=your-qwen-api-key

# ─── News APIs ────────────────────────────────────────────────────────────────
NEWSAPI_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-api-key
WORLDNEWS_API_KEY=your-worldnews-api-key

# ─── CRON / Admin ─────────────────────────────────────────────────────────────
# Used to protect /api/embed-backfill
CRON_SECRET=your-cron-secret

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for auth redirect URLs. In production set to your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
