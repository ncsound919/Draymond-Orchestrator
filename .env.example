# ============================================================================
# Draymond Orchestrator — Environment Variables
# Autonomous Business System Control Plane
# ============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── LLM Providers ──────────────────────────────────────────────────────────
# OpenAI — used by Vercel AI SDK for swarm task decomposition
OPENAI_API_KEY=your-openai-api-key

# Anthropic — used for Claude API calls (agent invocations, etc.)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Qwen (primary LLM — Uplift Guide AI + news analysis)
QWEN_API_KEY=your-qwen-api-key

# ─── News APIs ────────────────────────────────────────────────────────────────
NEWSAPI_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-api-key
WORLDNEWS_API_KEY=your-worldnews-api-key

# ─── CRON / Admin ─────────────────────────────────────────────────────────────
# Protects /api/cron, /api/seed, /api/monitors/check, /api/notifications/test
# Use a long random string. Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret

# ─── SSRF / Local Agent Access ────────────────────────────────────────────────
# In production, the invoker blocks localhost/private IPs to prevent SSRF.
# In development (NODE_ENV!=production), localhost is allowed automatically.
# Set this to "1" to explicitly allow local agents in any environment:
# ALLOW_LOCAL_AGENTS=1

# ─── Email Notifications (Gmail + Nodemailer) ────────────────────────────────
# Gmail address to send notifications FROM
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Factor Authentication enabled on the Google account
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email address to receive alert notifications (defaults to GMAIL_USER)
DRAYMOND_ALERT_EMAIL=your-alert-recipient@gmail.com

# ─── ntfy Push Approvals (human-in-the-loop relay) ───────────────────────────
# When a confidence-gated action is queued for review, Draymond publishes an
# ntfy notification with Approve/Reject HTTP action buttons. Open-Chat
# subscribes to the topic and renders the buttons, which POST back here.
#
# Public ntfy server (free) — or self-host at https://docs.ntfy.sh/install/
NTFY_URL=https://ntfy.sh

# Any string topic — ideally unique to your deployment to avoid collisions.
NTFY_TOPIC=draymond-approvals

# Publicly reachable base URL of THIS app. Used to build the review callback
# URL embedded in the ntfy notification. Use a tunnel (e.g. Cloudflare) in
# development if the phone is not on your LAN.
DRAYMOND_PUBLIC_URL=https://your-draymond-instance.com

# ─── Agent URLs ──────────────────────────────────────────────────────────────
# Each agent gets a unique port to avoid conflicts.
# Draymond itself runs on :3444. See port map below.
#
# PORT MAP:
#   3444  — Draymond Orchestrator (this app)
#   3001  — Bet Buddy (Express.js, companion to Sports Steve)
#   3010  — OmniResearch Pro (Express.js backend)
#   3020  — Overlay Chain / ChainFlow (Next.js supply chain)
#   8000  — Uplift Agent (batch_server.py, Hermes fork)
#   8010  — Sports Steve (FastAPI sports betting)
#   8020  — Indy Music Platform / NC Studio (FastAPI)
#   8030  — Social Media Dashboard AI API (FastAPI)
#   8040  — TradingAgents HTTP wrapper (future — currently python_module)
#   8050  — Sub Team HTTP wrapper (future — currently subprocess)
#   9744  — MegaCode JetBrains bridge (HTTP)

# Uplift Agent (Hermes fork — primary worker, batch_server.py)
UPLIFT_BASE_URL=http://localhost:8000

# Sports Steve (FastAPI — daily bet assessment + resolution)
SPORTS_STEVE_URL=http://localhost:8010

# Bet Buddy (Express.js — odds calc, Kelly criterion, bankroll)
BET_BUDDY_URL=http://localhost:3001

# Social Media Dashboard AI API (FastAPI — text/image/video/podcast/voice)
SOCIAL_MEDIA_URL=http://localhost:8030

# OmniResearch Pro (Express.js — Ollama proxy, web search, Slack/Notion)
OMNI_RESEARCH_URL=http://localhost:3010

# Indy Music Platform / NC Studio (FastAPI — artist sites, social, distribution)
INDY_MUSIC_URL=http://localhost:8020

# MegaCode / OverCoat (TypeScript — JetBrains HTTP bridge)
MEGACODE_URL=http://localhost:9744

# Overlay Chain / ChainFlow (Next.js — supply chain intelligence)
OVERLAY_CHAIN_URL=http://localhost:3020

# TradingAgents (Python library — no HTTP server, invoked via python_module)
# Only needed if you deploy an HTTP wrapper:
# TRADING_AGENTS_URL=http://localhost:8040
TRADING_AGENTS_DIR=/path/to/agents/TradingAgents-main

# Sub Team (Python library — no HTTP server, invoked via subprocess)
# Only needed if you deploy an HTTP wrapper:
# SUB_TEAM_URL=http://localhost:8050
SUB_TEAM_DIR=/path/to/agents/Sub-Team-main

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for auth redirect URLs. In production set to your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3444
NEXT_PUBLIC_APP_URL=http://localhost:3444

# ─── Python Runtimes ─────────────────────────────────────────────────────────
# Path to Python executables for subprocess/module invocations.
# On Windows, "python" is usually correct. On macOS/Linux, use "python3".
CCE_PYTHON=python
TRADING_AGENTS_PYTHON=python
SUB_TEAM_PYTHON=python

# ─── Paths ────────────────────────────────────────────────────────────────────
# Root directory for Claude Code Extension agent
CCE_ROOT=/path/to/cce

# File-based registry directory (defaults to .draymond/ in project root)
DRAYMOND_REGISTRY_DIR=.draymond

# Audit log file path (flat-file append log for admin audit trail)
AUDIT_LOG_PATH=.draymond/audit.log

# ── DeepSeek Router LLM ──────────────────────────────────────────────────────
# Primary LLM for Draymond's Intelligent Task Router (intent classification).
DEEPSEEK_API_KEY=your-deepseek-api-key

# ── AetherDesk Call Center Integration ───────────────────────────────────────
# Native AetherDesk FastAPI (no Docker) — see Aetherdesk-Call-Center/Makefile.
# Run: make setup && make dev  (uvicorn on 127.0.0.1:8000, SQLite)
AETHERDESK_BASE_URL=http://127.0.0.1:8000/api/v1
# Mirror INTERNAL_API_KEY from Aetherdesk-Call-Center/.env (generated by make setup)
AETHERDESK_API_KEY=your-aetherdesk-internal-api-key

# ── ntfy Result Notifications ────────────────────────────────────────────────
# Separate topic from NTFY_TOPIC so approval messages stay clean.
# Open-Chat subscribes to this topic (plus draymond-approvals) via an ntfy bot.
NTFY_TOPIC_RESULTS=draymond-results

# OpenCode Zen free / Go tiers (used by the LLM provider chain in llm.ts)
OPENCODE_API_KEY=your-opencode-api-key

# Google Gemini (Generative Language API) - fallback provider in the chain
GEMINI_API_KEY=your-gemini-api-key

# CORS - comma-separated origins allowed to call /api/* from the browser.
# When unset, cross-origin browser requests are denied (server-side clients unaffected).
CORS_ORIGIN=https://your-frontend-origin.com

# ─── Book Library (BookBridge) ───────────────────────────────────────────────
# BookBridge REST endpoint (agents/BookBridge--main). Set DRAYMOND_BOOK_GROUNDING
# to "true" to have the chain-builder inject relevant book passages into task
# prompts so agents reason from the library instead of memorized guesswork.
BOOKBRIDGE_URL=http://127.0.0.1:8777
DRAYMOND_BOOK_GROUNDING=true

# ─── AgentBrowser (browser skills / file fetch) ──────────────────────────────
# AgentBrowser runs its own server (default :3000). It guards its browser-task
# API with an API key — set the matching value from AgentBrowser's .env.
AGENTBROWSER_URL=http://localhost:3000
AGENTBROWSER_API_KEY=your-agentbrowser-api-key

# ─── Music Rights (ASCAP / HFA / MLC) ───────────────────────────────────────
# Directory holding AgentBrowser's mini-services/music-rights scripts.
# Credentials are passed per-request to /api/music/register, never stored.
MUSIC_RIGHTS_DIR=/path/to/agents/AgentBrowser-main/mini-services/music-rights


