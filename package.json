{
    "name": "uplift-lab",
    "main": "electron/main.js",
    "version": "1.0.0",
    "private": false,
    "description": "Draymond Orchestrator — the central nervous system for AI agents: registry, chains, scheduler, monitors, approvals, and LLM provider routing",
    "engines": {
        "node": ">=20.19.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ncsound919/Draymond-Orchestrator.git"
    },
    "bugs": {
        "url": "https://github.com/ncsound919/Draymond-Orchestrator/issues"
    },
    "homepage": "https://github.com/ncsound919/Draymond-Orchestrator#readme",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "prebuild": "node scripts/prune-next.mjs",
        "clean": "node scripts/prune-next.mjs",
        "verify:build": "node scripts/verify-build.mjs --verify",
        "start": "next start",
        "start:pm2": "pm2 start ecosystem.config.js && pm2 save",
        "stop:pm2": "pm2 stop draymond",
        "logs:pm2": "pm2 logs draymond",
        "lint": "eslint . --ext .ts,.tsx",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "memory:rebuild": "tsx scripts/rebuild-memory-projections.ts",
        "seed:mcp": "tsx scripts/seed-reference-mcp-servers.ts",
        "audit:skills": "tsx scripts/audit-skill-frontmatter.ts",
        "gate": "npm run type-check && npm run lint && npm test",
        "electron:dev": "npm run build && electron .",
        "electron:build": "npm run build && electron-builder --win --mac --linux",
        "test:coverage": "vitest run --coverage"
    },
    "build": {
        "appId": "ai.draymond.orchestrator",
        "productName": "Draymond Orchestrator",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/main.js",
            ".next/standalone/server.js",
            ".next/standalone/.next/**/*",
            ".next/standalone/node_modules/**/*",
            ".next/standalone/public/**/*",
            "public/**/*",
            "next.config.ts",
            "next-env.d.ts",
            "package.json"
        ],
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*",
            "node_modules/sqlite-vec/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Draymond-Orchestrator-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Draymond Orchestrator"
        },
        "npmRebuild": true
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
        "@sentry/nextjs": "^10.69.0",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-table": "^9.1.2",
        "@toon-format/toon": "^4.1.1",
        "@xenova/transformers": "^2.17.2",
        "better-sqlite3": "^12.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.13",
        "echarts": "^6.1.0",
        "idb-keyval": "^6.3.0",
        "katex": "^0.18.1",
        "lucide-react": "^1.31.0",
        "next": "^16.3.0",
        "next-themes": "^0.4.6",
        "nodemailer": "^9.0.4",
        "nuqs": "^2.8.9",
        "prom-client": "^15.1.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hotkeys-hook": "^5.2.4",
        "shadcn": "^4.18.0",
        "sonner": "^2.0.7",
        "sqlite-vec": "^0.1.9",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^20",
        "@types/nodemailer": "^7.0.11",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^4.1.10",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9",
        "eslint-config-next": "^16.3.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.11",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
