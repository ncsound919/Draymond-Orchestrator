{
    "name": "uplift-lab",
    "main": "electron/main.js",
    "version": "1.0.0",
    "private": false,
    "description": "Draymond Orchestrator — the central nervous system for AI agents: registry, chains, scheduler, monitors, approvals, and LLM provider routing",
    "engines": {
        "node": ">=20.19.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ncsound919/Draymond-Orchestrator.git"
    },
    "bugs": {
        "url": "https://github.com/ncsound919/Draymond-Orchestrator/issues"
    },
    "homepage": "https://github.com/ncsound919/Draymond-Orchestrator#readme",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "start:pm2": "pm2 start ecosystem.config.js && pm2 save",
        "stop:pm2": "pm2 stop draymond",
        "logs:pm2": "pm2 logs draymond",
        "lint": "eslint . --ext .ts,.tsx",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "electron:dev": "next build && electron .",
        "electron:build": "next build && electron-builder --win --mac --linux",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
        "@sentry/nextjs": "^10.69.0",
        "@xenova/transformers": "^2.17.2",
        "better-sqlite3": "^13.0.3",
        "dompurify": "^3.4.13",
        "echarts": "^6.1.0",
        "idb-keyval": "^6.3.0",
        "katex": "^0.18.1",
        "next": "^16.3.0",
        "nodemailer": "^9.0.4",
        "nuqs": "^2.8.9",
        "prom-client": "^15.1.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hotkeys-hook": "^5.2.4",
        "sonner": "^2.0.7",
        "sqlite-vec": "^0.1.9",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/better-sqlite3": "^9.6.0",
