        "@types/nodemailer": "^7.0.11",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^4.1.10",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9",
        "eslint-config-next": "^16.3.0",
        "tailwindcss": "^4",
