{
  "model_id": "sports-02-data-governance",
  "description": "Cross-sport data governance protocol model: data quality + lineage + validation gate decision usefulness.",
  "state_vars": ["data_quality", "lineage", "validation_coverage", "decision_usefulness"],
  "params": {"quality_gain": 0.06, "lineage_gain": 0.05, "validation_eff": 0.07, "fragmentation_penalty": 0.2},
  "initial_state": {"data_quality": 0.4, "lineage": 0.3, "validation_coverage": 0.3, "decision_usefulness": 0.4},
  "update_rules": {
    "data_quality": "min(data_quality + quality_gain, 1)",
    "lineage": "min(lineage + lineage_gain, 1)",
    "validation_coverage": "min(validation_coverage + validation_eff, 1)",
    "decision_usefulness": "(0.4*data_quality + 0.3*lineage + 0.3*validation_coverage) * (1 - fragmentation_penalty)"
  },
  "events": [
    {"when": "decision_usefulness < 0.3", "action": "flag:data_no_truth_system"},
    {"when": "decision_usefulness > 0.7", "action": "flag:decision_ready"}
  ],
  "outputs": ["decision_usefulness", "validation_coverage"],
  "ticks": 48
}
