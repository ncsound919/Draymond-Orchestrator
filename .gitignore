!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron-builder output (large binaries — never push to GitHub)
/release/

# misc
.DS_Store
*.pem


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-stderr.log
dev-stdout.log
build_error.log

# env files (can opt-in for committing if needed)
.env
.env*.local
.env.local

# runtime audit log
/.audit/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Draymond operational data store
/.draymond/

# Local SQLite database, Supabase dumps, and paid release binaries
/data/

# Non-project directories
/downloads/
/Graphics/
/Phaselock-main/
/Scaffold/
/UsersUserDesktopThe-Uplift-Lab-clone/
/Issues to address/
/docs/
/nul
