/connect-supabase.js
__pycache__/
*.pyc
*.db
*.sqlite
.vscode/
.idea/
Thumbs.db
sessions/

# External agent packs (standalone repos, kept locally for integration)
/agents/

# Stray files
/DS Font/

# stray runtime logs
/cronfix.log

# Local secrets / one-off API tokens (never commit)
/Kaggle.txt

# Temp opencode debug scaffolding (one-off, machine-specific paths)
/_oc_*.cjs
/_oc_runner.cmd
/scripts/_test-start.ps1

# Generated knowledge-graph output (build artifact)
/graphify-out/

# Raw downloaded datasets (2.5GB+; re-fetch via science_engine/data/*_ingest.py or Kaggle)
/datasets/

# Dev server log
/dev-server.log

# local task markers and temp logs
/.task-markers/
/server-test.log

